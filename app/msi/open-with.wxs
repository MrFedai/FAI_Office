<!--
  Windows "Open with" entries of the MSI (P3.5). The packageMsi task (app/build.gradle.kts) adds the Fragment below
  to jpackage's own main.wxs, referenced from its DefaultFeature, so the entries are installed with the app and
  removed with it (Windows Installer deletes the registry values of an uninstalled component).

  Only suggestions, never a default-app claim: the ProgID FAIOffice.File and the Applications\fai-office.exe key
  describe how to open a file; each extension lists the ProgID under OpenWithProgids. The default value of
  Software\Classes\.<ext> (which would make the app the handler) is never written, and nothing is registered under
  RegisteredApplications / Default Apps. Per-user install: everything under HKCU, the component's key path too.
  Windows reads only the value names under OpenWithProgids and SupportedTypes; their data is a non-empty string
  because WiX 3 and the MSI Registry table treat an empty value specially.

  The extensions are those of every detected format with a registered MIME type (FileFormat, the same set as the
  Android intent filters); WindowsOpenWithTest checks the list and the rules above.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <ComponentGroup Id="FaiOpenWith">
      <Component Id="FaiOpenWithRegistry" Directory="INSTALLDIR" Guid="{718317B1-4F75-418B-A237-D641A0283CC4}">
        <RegistryValue Root="HKCU" Key="Software\FAI Office\OpenWith" Name="Installed" Value="1" Type="integer" KeyPath="yes"/>
        <RegistryValue Root="HKCU" Key="Software\Classes\FAIOffice.File" Value="FAI Office" Type="string"/>
        <RegistryValue Root="HKCU" Key="Software\Classes\FAIOffice.File\DefaultIcon" Value="&quot;[INSTALLDIR]fai-office.exe&quot;,0" Type="string"/>
        <RegistryValue Root="HKCU" Key="Software\Classes\FAIOffice.File\shell\open\command" Value="&quot;[INSTALLDIR]fai-office.exe&quot; &quot;%1&quot;" Type="string"/>
        <RegistryValue Root="HKCU" Key="Software\Classes\Applications\fai-office.exe" Name="FriendlyAppName" Value="FAI Office" Type="string"/>
        <RegistryValue Root="HKCU" Key="Software\Classes\Applications\fai-office.exe\shell\open\command" Value="&quot;[INSTALLDIR]fai-office.exe&quot; &quot;%1&quot;" Type="string"/>
        <RegistryValue Root="HKCU" Key="Software\Classes\.pdf\OpenWithProgids" Name="FAIOffice.File" Value="FAI Office" Type="string"/>
        <RegistryValue Root="HKCU" Key="Software\Classes\.docx\OpenWithProgids" Name="FAIOffice.File" Value="FAI Office" Type="string"/>
        <RegistryValue Root="HKCU" Key="Software\Classes\.docm\OpenWithProgids" Name="FAIOffice.File" Value="FAI Office" Type="string"/>
