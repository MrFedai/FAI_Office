# Phase 2 performance budgets, the one place their numbers live (MASTER_SPEC.md section 7; a budget changes only
# with new measurements and owner approval). Sourced by ci/lib.sh; every value can be overridden from the
# environment, which is how a deliberate regression is tested: BUDGET_APK_MB=1 ci/budget.sh must fail.
# MB here is 1024 * 1024 bytes.
: "${BUDGET_APK_MB:=30}"            # Android base download, light core, one ABI (arm64-v8a)
: "${BUDGET_COLD_START_MS:=1500}"   # cold start to usable Home screen, Android and Linux
: "${BUDGET_HOME_PSS_MB:=150}"      # Android RAM on Home, no document: PSS including graphics
: "${BUDGET_WEB_GZIP_MB:=5}"        # Web initial load, light core, gzip -9
: "${BUDGET_LINUX_PKG_MB:=150}"     # Linux package, light core, installed
: "${BUDGET_WINDOWS_PKG_MB:=150}"   # Windows package, light core, installed (same section 7 row as Linux)
: "${BUDGET_DESKTOP_RAM_MB:=300}"   # desktop RAM at rest: native Windows working set 245.6 MB (2026-11-21), owner approved 300
export BUDGET_APK_MB BUDGET_COLD_START_MS BUDGET_HOME_PSS_MB BUDGET_WEB_GZIP_MB BUDGET_LINUX_PKG_MB \
    BUDGET_WINDOWS_PKG_MB BUDGET_DESKTOP_RAM_MB
